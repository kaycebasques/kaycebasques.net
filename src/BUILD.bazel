load("@rules_python//sphinxdocs:sphinx.bzl", "sphinx_build_binary", "sphinx_docs")
load("@rules_python//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")

package(default_visibility = ["//visibility:public"])

sphinx_docs_library(
    name = "srcs",
    srcs = [
        "index.rst",
    ],
    deps = [
        "//src/blog",
        "//src/math",
    ],
)

sphinx_build_binary(
    name = "sphinx",
    deps = [
        "//theme",
        "//extensions/dragon",
        "//extensions/sitemap",
        "@pypi//sphinx",
    ],
    visibility = ["//visibility:public"],
)

sphinx_docs(
    name = "src",
    config = "conf.py",
    formats = ["html"],
    sphinx = ":sphinx",
    strip_prefix = "src/",
    deps = [":srcs"],
    extra_opts = ["--fail-on-warning"],
    allow_persistent_workers = False,
    visibility = ["//visibility:public"],
)
